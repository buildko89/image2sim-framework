# Local environment
.env
.venv/
.venv_triposr/
.venv_hunyuan3d/
external/
third_party/

# 作業指示メモ（ローカル専用。公開しない）
/prompt*.md

# ゲームエンジンの作業フォルダ（ローカル専用。公開しない。2026-07-16 に GitHub から削除）
# godot/ には購入素材の原本 scene.gltf 由来物が含まれるため誤って戻さないこと
/godot/
/unity/
/unreal/

# v1 期の設計・タスク文書（ローカル専用。公開しない。2026-07-16 に GitHub から削除。
# README 用プレビュー画像は images/ へ移設済み）
/docs/

# Python cache and test cache
__pycache__/
.pytest_cache/

# Input artifacts — 全除外（公開リポジトリ。実物の写真と購入素材を含むため）
input/

# Generated outputs
output/raw_3d/*
!output/raw_3d/.gitkeep
output/clean_3d/*
!output/clean_3d/.gitkeep
output/rigged/*
!output/rigged/.gitkeep
output/godot/*
!output/godot/.gitkeep
output/unity/*
!output/unity/.gitkeep
output/unreal/*
!output/unreal/.gitkeep
output/reports/*
!output/reports/.gitkeep
output/model_cache/*
output/textures/
output/godot_run_error.txt

# 3D assets
*.glb
*.fbx
*.obj
*.blend

# Generated images and intermediate artifacts
output/**/*.png
output/**/*.jpg
output/**/*.jpeg
output/**/*.webp
output/**/*.tif
output/**/*.tiff
output/**/*.bmp
output/**/*.exr

# ---- v2 (Route B: 実物の猫 koha の可動モデル) ----
# 方針: 実写真・購入素材・再生成可能な生成物は公開しない。
# 公開するのは現行の作業モデル p3_koha9face の成果物（glb/blend/テクスチャ3枚）だけ。
png/
newplan/reference_sheet.png
*.npz
output_v2/**
!output_v2/base/
!output_v2/base/p3_koha9face.glb
!output_v2/base/p3_koha9face.blend
!output_v2/textures/
!output_v2/textures/p3_koha9face_basecolor.png
!output_v2/textures/p3_koha9face_basecolor_alpha.png
!output_v2/textures/p3_koha9face_fur_shell.png
# Godot の作業キャッシュと GLB インポート時の自動展開テクスチャ（場所を問わず除外・再生成可能）
**/.godot/
output_v2/godot/**/*.png

# Keep repository placeholders
!.gitkeep
