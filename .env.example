# API keys must be configured in .env and must not be committed to Git.
TRIPO_API_KEY=
MESHY_API_KEY=

# BLENDER_PATH must be the absolute path to the Blender executable.
# Windows example:
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.3\blender.exe
# If you use WSL2, be careful with path conversion between /mnt/c/... and C:\...
BLENDER_PATH=

UNITY_PROJECT_PATH=
