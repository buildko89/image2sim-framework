output/**/*.jpg
output/**/*.jpeg
output/**/*.webp
output/**/*.tif
output/**/*.tiff
output/**/*.bmp
output/**/*.exr

# ---- v2 (Route B: 実物の猫 koha の可動モデル) ----
# 方針: 実写真・購入素材・再生成可能な生成物は公開しない。
# 公開するのは現行の作業モデル p3_koha9face の成果物（glb/blend/テクスチャ3枚）だけ。
png/
newplan/reference_sheet.png
*.npz
output_v2/**
!output_v2/base/
!output_v2/base/p3_koha9face.glb
!output_v2/base/p3_koha9face.blend
!output_v2/textures/
!output_v2/textures/p3_koha9face_basecolor.png
!output_v2/textures/p3_koha9face_basecolor_alpha.png
!output_v2/textures/p3_koha9face_fur_shell.png
# Godot の作業キャッシュと GLB インポート時の自動展開テクスチャ（場所を問わず除外・再生成可能）
**/.godot/
output_v2/godot/**/*.png

# ---- 公開: Godot 猫コントローラプロジェクト（2026-07-17 ユーザー指示）----
# シーン・スクリプト・設定は公開。生成物（モデル glb 本体・自動抽出テクスチャ・キャッシュ）は
# 除外 — glb は output_v2/base/p3_koha9face.glb をコピーすれば同じもの（README 参照）。
# p3_koha9face.glb.import はループ設定を持つ手書き構成なので公開する。
!output_v2/godot/
!output_v2/godot/Godot3dcat/
!output_v2/godot/Godot3dcat/**
output_v2/godot/Godot3dcat/*.glb
output_v2/godot/Godot3dcat/*.png
output_v2/godot/Godot3dcat/*.png.import
output_v2/godot/Godot3dcat/.godot/

# Keep repository placeholders
!.gitkeep

